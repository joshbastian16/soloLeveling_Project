<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="file:/C:/gitHub/soloLeveling_Project/chapter_xml/projectSchema.rnc" type="application/relax-ng-compact-syntax"?>
<chapter num="12">
    <title>Solo Leveling</title>
    <author>Chugong</author>
    <illustrator>Jang Sung-Rak</illustrator>
    <body>
        <page pageNum="1"/>

        <pageBrk/>

        <page pageNum="2">
            <bubble type="speech" spNum="1" who="Sung Jin-Woo">
                <unique ans="y" uniNum="1"/>AHHHHHHHHHH </bubble>
        </page>

        <pageBrk/>

        <page pageNum="3">
            <systemMsg type="information">
                <info>ALARM</info>
                <info>[PENALTY QUEST: SURVIVE.]</info>
                <info>GOAL: SURVIVE UNTIL THE TIME RUNS OUT. </info>
                <info>TIME REQUIRED: 4 HOURS </info>
                <info>TIME REMAINING 0H 0 MIN 7 SEC</info>
            </systemMsg>
            <systemMsg type="information">
                <info>ALARM</info>
                <info>[YOU HAVE COMPLETED THE 'PENALTY' QUEST]</info>
            </systemMsg>
        </page>

        <pageBrk/>

        <page pageNum="4">
            <systemMsg type="information">
                <info>ALARM</info>
                <info>[YOU HAVE COMPLETED THE 'PENALTY' QUEST]</info>
            </systemMsg>
            <bubble type="speech" spNum="2" who="Sung Jin-Woo">
                <unique ans="n"/> [PENALTY QUEST]? </bubble>
            <systemMsg type="information">
                <info>MESSAGE </info>
                <info>[YOUR REWARDS FOR COMPLETING THE PENALTY QUEST HAVE ARRIVED.] </info>
                <info>[WOULD YOU LIKE TO ACCEPT?]</info>
                <info>[ACCEPT]</info>
                <info>[REFUSE]</info>
            </systemMsg>
        </page>

        <pageBrk/>

        <page pageNum="5">
            <bubble type="speech" spNum="3" who="nurseOne">
                <unique ans="y" uniNum="2"/> OH MY GOSH! WHAT HAPPENED HERE?! </bubble>
            <bubble type="speech" spNum="4" who="nurseOne">
                <unique ans="n"/> SOMEONE COME AND HELP, PLEASE </bubble>
        </page>

        <pageBrk/>

        <page pageNum="6">
            <bubble type="speech" spNum="5" who="nurseTwo">
                <unique ans="y" uniNum="3"/> YOU KNOW A PATIENT NAMED SUNG JIN-WOO? I HEARD THAT
                HE'S A HUNTER? </bubble>
            <bubble type="speech" spNum="6" who="nurseThree">
                <unique ans="y" uniNum="4"/> AHH YEAH, YEAH. HE'S BEEN RUNNING EVERY DAY EVEN
                THOUGHT IT'S ONLY BEEN A COUPLE DAYS SINCE HE WOKE UP. </bubble>
            <bubble type="speech" spNum="7" who="nurseTwo">
                <unique ans="n"/> WHAT DID THE DOCTOR SAY? </bubble>
            <bubble type="speech" spNum="8" who="nurseThree">
                <unique ans="n"/> THE DOCTOR SAID THAT HUNTERS HEAL FASTER THAN NORMAL PEOPLE, SO
                LIGHT EXERCISE SHOULD BE FINE. </bubble>
            <bubble type="speech" spNum="9" who="nurseTwo">
                <unique ans="n"/> LOOK, HE'S EVEN RUNNING RIGHT NOW. </bubble>
            <bubble type="speech" spNum="10" who="nurseTwo">
                <unique ans="n"/> IF IT'S LIGHT EXERCISE... </bubble>
            <bubble type="speech" spNum="11" who="nurseTwo">
                <unique ans="n"/> IT'S REALLY OKAY RIGHT? </bubble>
            <bubble type="speech" spNum="12" who="nurseTwo">
                <unique ans="n"/> HOW MANY HOURS HAS HE BEEN RUNNING? </bubble>
            <caption type="thought" thtNum="1" who="Sung Jin-Woo">IT'S BEEN 4 DAYS SINCE I WOKE
                UP.</caption>
            <caption type="thought" thtNum="2" who="Sung Jin-Woo">THERE ARE A FEW THINGS THAT I
                FOUND OUT.</caption>
        </page>

        <pageBrk/>

        <page pageNum="7">
            <caption type="thought" thtNum="3" who="Sung Jin-Woo">FIRST,</caption>
            <caption type="thought" thtNum="4" who="Sung Jin-Woo">THIS THING IN FRONT OF MY EYES IS
                NOT AN ILLUSION.</caption>
            <systemMsg type="information">
                <info>ALARM</info>
                <info>[RUNNING] 10KM: COMPLETE (10/10km)</info>
            </systemMsg>
            <caption type="thought" thtNum="5" who="Sung Jin-Woo">ALTHOUGH NOBODY ELSE CAN, I CAN
                SEE IT CLEARLY IN FRONT OF MY EYES.</caption>
            <systemMsg type="information">
                <info>QUEST DIRECTIONS</info>
                <info>GOAL</info>
                <info>PUSH-UPS [100/100]</info>
                <info>SIT-UPS [100/100]</info>
                <info>SQUATS [100/100]</info>
                <info>RUNNING [10/10km]</info>
                <info>QUEST REWARDS CHOOSE YOUR REWARD</info>
                <info>[YOU MAY CHOOSE ONE OF THE REWARDS BELOW.]</info>
                <info>REWARD#1. STATUS RECOVERY</info>
                <info>REWARD#2. STAT POINTS +3</info>
                <info>REWARD#3. RANDOM BOX +1</info>
                <info>WILL YOU ACCEPT?</info>
                <info>[ACCEPT]</info>
                <info>[REJECT]</info>
            </systemMsg>
            <bubble type="speech" spNum="13" who="Sung Jin-Woo">
                <unique ans="n"/> ACCEPT STATUS RECOVERY. </bubble>
        </page>

        <pageBrk/>

        <page pageNum="8">
            <caption type="thought" thtNum="6" who="Sung Jin-Woo">MAGIC THAT CAN HEAL YOUR FATIGUE
                AFTER EXERCISING.</caption>
            <caption type="thought" thtNum="7" who="Sung Jin-Woo">THE FATIGUE THAT NESTED IN MY
                WHOLE BODY ACTUALLY DISAPPEARS AS IF IT WASN'T EVEN THERE IN THE FIRST
                PLACE.</caption>
            <caption type="thought" thtNum="8" who="Sung Jin-Woo">ASIDE FROM THAT, THERE ARE ASLO
                STAT POINTS AND THE RANDOM BOX ITEMS. YOU CAN INCREASE ANY ONE OF YOUR CHARACTER
                STATS AT WILL AS LONG AS YOU HAVE STAT POINTS.</caption>
            <systemMsg type="information">
                <info>ALARM</info>
                <info>YOU HAVE RECIEVED THE [RANDOM BOX]</info>
            </systemMsg>
            <systemMsg type="statSheet">
                <info>STATUS</info>
                <info> NAME: SUNG JIN-WOO</info>
                <level>LEVEL:1</level>
                <info>JOB: NONE </info>
                <info>FATIGUE:0</info>
                <info>TITLE: NONE</info>
                <info>HP: 100</info>
                <info>MP: 10</info>
                <stat>STRENGTH:16</stat>
                <stat>VITALITY:10</stat>
                <stat>AGILITY: 10</stat>
                <stat>INTELLIGENCE:10</stat>
                <stat>SENSE:10</stat>
                <info>REMAINING POINTS: 3</info>
            </systemMsg>
            <caption type="thought" thtNum="9" who="Sung Jin-Woo">I GET STRONGER AS I INCREASE MY
                STATS, OF COURSE, INCREASING LEVELS WOULD DO THE SAME.</caption>
            <caption type="thought" thtNum="10" who="Sung Jin-Woo">STATUS, SKILLS, ITEMS, INVENTORY,
                ITEM STORAGE,</caption>
            <systemMsg type="skill">
                <info>SKILLS</info>
                <info>[PASSIVE]</info>
                <info>(UNKOWN) MAX</info>
                <info> MUSCULARITY Lv.1</info>
                <info>[ACTIVE]</info>
                <info>SPRINT Lv.1</info>
            </systemMsg>
            <caption type="thought" thtNum="11" who="Sung Jin-Woo">IT'S LIKE A GAME.</caption>
            <caption type="thought" thtNum="12" who="Sung Jin-Woo">BEING CONTROLLED BY SOME STRANGE
                PHENOMENON...</caption>
        </page>

        <pageBrk/>

        <page pageNum="9">
            <bubble type="speech" spNum="14" who="Sung Jin-Woo">
                <unique ans="n"/> HAHA... WHAT'S ACTUALLY HAPPENING HERE... </bubble>
            <systemMsg type="statSheet">
                <info>STATUS</info>
                <info> NAME: SUNG JIN-WOO</info>
                <level>LEVEL:1</level>
                <info>JOB: NONE </info>
                <info>FATIGUE:0</info>
                <info>TITLE: NONE</info>
                <info>HP: 100</info>
                <info>MP: 10</info>
                <stat>STRENGTH:16</stat>
                <stat>VITALITY:10</stat>
                <stat>AGILITY: 10</stat>
                <stat>INTELLIGENCE:10</stat>
                <stat>SENSE:10</stat>
                <info>REMAINING POINTS: 3</info>
            </systemMsg>
            <bubble type="speech" spNum="15" who="Sung Jin-Woo">
                <unique ans="n"/> CAN I TAKE A LEAVE FOR TODAY? </bubble>
        </page>

        <pageBrk/>

        <page pageNum="10">
            <bubble type="speech" spNum="16" who="receptionist">
                <unique ans="y" uniNum="5"/> IT'S FINE, BUT WHERE ARE YOU GOING? </bubble>
            <bubble type="speech" spNum="17" who="Sung Jin-Woo">
                <unique ans="n"/> I HAVE TO TAKE CARE OF SOME BUISNESS OUTSIDE. </bubble>
            <bubble type="speech" spNum="18" who="Sung Jin-Woo">
                <unique ans="n"/> IT'S TIME TO FIGURE OUT WHAT THIS DOES. </bubble>
            <bubble type="speech" spNum="19" who="Sung Jin-Woo">
                <unique ans="n"/> THE RANDOM BOX THAT COMES OUT EVERY TIME I CLEAR THE DAILY QUEST.
                ALTHOUGH SOMETIMES USELESS ITEMS LIKE BANDAGES AND PENS COME OUT... THIS SEEMS
                DIFFERENT. </bubble>
            <systemMsg type="item">
                <info>[ITEM: DUNGEON KEY]</info>
                <info>ITEM CLASS: E</info>
                <info>TYPE: KEY</info>
                <info>A KEY THAT ALLOWS YOU TO CREATE AN INSTANT DUNGEON.</info>
                <info>YOU MAY USE THIS IN THE 3RD ENTERANCE OF HAPJUNG STATION.</info>
            </systemMsg>
        </page>

        <pageBrk/>

        <page pageNum="11">
            <bubble type="speech" spNum="20" who="Sung Jin-Woo">
                <unique ans="n"/> A KEY THAT CAN OPEN INSTANT DUNGEONS... </bubble>
            <bubble type="speech" spNum="21" who="Sung Jin-Woo">
                <unique ans="n"/> QUESTS, THE STATUS WINDOW, REWARDS... COULD IT BE THAT ALL OF
                THIS... </bubble>
            <bubble type="speech" spNum="22" who="Sung Jin-Woo">
                <unique ans="n"/> IS BECAUSE OF THE DOUBLE AWAKENING? </bubble>
            <bubble type="speech" spNum="23" who="Sung Jin-Woo">
                <unique ans="n"/> OR, PERHAPS A PROCEDURE TOWARDS THE DOUBLE AWAKENING? </bubble>
            <bubble type="speech" spNum="24" who="Sung Jin-Woo">
                <unique ans="n"/> IT THAT'S THE CASE, IT'S WORTH TRYING OUT! </bubble>
            <bubble type="speech" spNum="25" who="Sung Jin-Woo">
                <unique ans="n"/> THE WORLD'S WEAKEST RECIEVING A DOUBLE AWAKENING, HUH... </bubble>
            <bubble type="speech" spNum="26" who="Sung Jin-Woo">
                <unique ans="n"/> OTHER PEOPLE WOULD LAUGH IF THEY HEARD. </bubble>
            <bubble type="speech" spNum="27" who="Sung Jin-Woo">
                <unique ans="n"/> I'M CONFIDENT IN MY ABILITY TO RUN, </bubble>
            <bubble type="speech" spNum="28" who="Sung Jin-Woo">
                <unique ans="n"/> SO IF IT BECOMES TOO DANGEROUS LIKE ALST TIME, I'LL RUN AWAY NO
                MATTER WHAT. </bubble>
        </page>

        <pageBrk/>

        <page pageNum="12"/>

        <pageBrk/>

        <page pageNum="13">
            <systemMsg type="information">
                <info>ALARM</info>
                <info>[YOU HAVE ENTERED THE INSTANT DUNGEON]</info>
            </systemMsg>
            <bubble type="speech" spNum="29" who="Sung Jin-Woo">
                <unique ans="n"/> NO WAY... THE ENTRANCE GOT BLOCKED?! </bubble>
            <bubble type="speech" spNum="30" who="Sung Jin-Woo">
                <unique ans="n"/> IS THIS SOME OTHER DIMENSION...? </bubble>
            <bubble type="speech" spNum="31" who="Sung Jin-Woo">
                <unique ans="n"/> IT'S DIFFERENT FROM NORMAL DUNGEONS. </bubble>
            <bubble type="speech" spNum="32" who="Sung Jin-Woo">
                <unique ans="n"/> I'VE NEVER SEEN IT BEFORE, BUT IT SHOULD BE SIMILAR TO THE RED
                GATE. </bubble>
        </page>

        <pageBrk/>

        <page pageNum="14">
            <bubble type="speech" spNum="33" who="Sung Jin-Woo">
                <unique ans="n"/> WHAT DO I DO NOW... I WAS PLANNING TO RUN IF SOMETHING BAD
                HAPPENED. </bubble>
            <bubble type="speech" spNum="34" who="Sung Jin-Woo">
                <unique ans="n"/> IF THEY BLOCK THE EXIT THEN I CAN'T EVEN RUN AWAY! </bubble>
            <systemMsg type="information">
                <info>ALARM </info>
                <info>[YOU CANNOT LEAVE THE</info>
                <info>DUNGEON. EITHER KILL THE BOSS OR</info>
                <info>USE THE RETURN CRYSTAL]</info>
            </systemMsg>
            <bubble type="speech" spNum="35" who="Sung Jin-Woo">
                <unique ans="n"/> YOU ACTUALLY CAN'T LEACE UNLESS YOU KILL THE BOSS... </bubble>
            <bubble type="speech" spNum="36" who="Sung Jin-Woo">
                <unique ans="n"/> IT WAS ONLY A FEW DAYS AGO WHEN I STRUGGLED WITH E-RANK MONSTERS,
                AND NOW I'M SUPPOSED TO CLEAR THIS DUNGEON BY MYSELF? </bubble>
            <bubble type="speech" spNum="37" who="Sung Jin-Woo">
                <unique ans="n"/> DAMN... YOU GOTTA BE KIDDING ME... </bubble>
        </page>

        <pageBrk/>

        <page pageNum="15">
            <bubble type="speech" spNum="38" who="Sung Jin-Woo">
                <unique ans="n"/> I'M SERIOUSLY EXPECTED... </bubble>
            <bubble type="speech" spNum="39" who="Sung Jin-Woo">
                <unique ans="n"/> TO MANAGE THIS WITHOUT A PARTY?! </bubble>
        </page>
    </body>
</chapter>
