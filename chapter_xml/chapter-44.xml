                <info>[WHEREVER THE PLAYER GOES,</info>
                <info>THE REAPER FOLLOWS.]</info>
            </systemMsg>
            <systemMsg type="information">
                <info>[THE PLAYER'S PATH IS LITTERED WITH CORPSES,</info>
                <info>AND THE SMELL OF BLOOD,]</info>
            </systemMsg>
