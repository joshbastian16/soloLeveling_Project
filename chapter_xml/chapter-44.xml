            <bubble type="speech" spNum="7" who="Sung Jin-Woo">
                <unique ans="n"/> SINCE I USE A DAGGER, IT'S OBVIOUS THAT I SHOULD CHOOSE ASSASSIN. </bubble>
            <systemMsg type="information">
                <info>[A JOB WILL BE GRANTED AFTER THE</info>
                <info>PLAYER'S ACTIONS HAVE BEEN ANALYSED.]</info>
            </systemMsg>
